RunService.Heartbeat:Connect(function()
    if not hitboxmodificationEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local playing = false
    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do
        if table.find(AttackAnims, t.Animation.AnimationId) and (t.TimePosition / t.Length < 0.75) then
            playing = true
            break
        end
    end
    if not playing then return end

    local Target
    local ND = MaxRange
    local function scan(grp)
        for _, o in ipairs(grp) do
            if o == char or not o:FindFirstChild("HumanoidRootPart") then continue end
            local d = (o.HumanoidRootPart.Position - hrp.Position).Magnitude
            if d < ND then ND = d Target = o end
        end
    end
    local pf = Workspace:FindFirstChild("Players")
    if pf then scan(pf:GetDescendants()) end
    local map = Workspace:FindFirstChild("Map", true)
    local npcs = map and map:FindFirstChild("NPCs", true)
    if npcs then scan(npcs:GetChildren()) end
    if not Target then return end

    local ping = LocalPlayer:GetNetworkPing()
    local ro = Vector3.new(RNG:NextNumber(-1.5,1.5), 0, RNG:NextNumber(-1.5,1.5))
    local pred = Target.HumanoidRootPart.Position + ro + (Target.HumanoidRootPart.Velocity * (ping * 1.25))
    local nv = (pred - hrp.Position) / (ping * 2)
    local ov = hrp.Velocity
    hrp.Velocity = nv
    RunService.RenderStepped:Wait()
    hrp.Velocity = ov
end)

