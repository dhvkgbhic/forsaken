local function triggerNearestGenerator(shouldLoop)
    while shouldLoop do
        looping = true
        task.wait(timeforonegen + math.random() * 0.5)
        local map = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Ingame")
            and Workspace.Map.Ingame:FindFirstChild("Map")
        if map then
            local closest, cd = nil, math.huge
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, g in ipairs(map:GetChildren()) do
                    if g.Name == "Generator" and g:FindFirstChild("Progress") and g.Progress.Value < 100 then
                        local mn = g:FindFirstChild("Main")
                        if mn then
                            local d = (mn.Position - hrp.Position).Magnitude
                            if d < cd then cd = d closest = g end
                        end
                    end
                end
            end
            if closest and closest:FindFirstChild("Remotes") and closest.Remotes:FindFirstChild("RE") then
                closest.Remotes.RE:FireServer()
            end
        end
    end
    looping = false
end

