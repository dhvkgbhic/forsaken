        h.Name = ITEM_ESP
        h.Adornee = tool
        h.FillColor = color
        h.OutlineColor = Color3.new(1,1,1)
        h.Parent = tool
        setHlVis(h, ESP_Enabled)
        allHighlights[h] = true
    end
end

local function highlightTool(tool)
    if tool:IsA("Tool") then
        if tool.Name == "Medkit" then
            applyItemHl(tool, Color3.fromRGB(0,255,0))
        elseif tool.Name == "BloxyCola" or tool.Name == "Cola" then
            applyItemHl(tool, Color3.fromRGB(0,150,255))
        end
    end
end

local function addGenHl(model)
    if model:FindFirstChild(GEN_ESP) then return end
    local h = Instance.new("Highlight")
    h.Name = GEN_ESP
    h.FillColor = Color3.fromRGB(255,255,0)
    h.Adornee = model
    h.Parent = model
    setHlVis(h, ESP_Enabled)
    allHighlights[h] = true
end

local function removeGenHl(model)
    local e = model:FindFirstChild(GEN_ESP)
    if e then
        allHighlights[e] = nil
        e:Destroy()
    end
end

local function trackGen(gen)
    local prog = gen:FindFirstChild("Progress")
    local inst = gen:FindFirstChild("Instances")
    if not prog or not inst then return end
    local gm = inst:FindFirstChild("Generator")
    if not gm or not gm:IsA("Model") then return end
    if prog.Value < 100 then addGenHl(gm) else removeGenHl(gm) end
    prog:GetPropertyChangedSignal("Value"):Connect(function()
        if prog.Value >= 100 then removeGenHl(gm) else addGenHl(gm) end
    end)
end

