local PLAYER_ESP = "PlayerESP"
local ITEM_ESP = "ToolESPHighlight"
local GEN_ESP = "GeneratorESP"
local TRAP_ESP = "TrapsandSpikesESP"
local allHighlights = {}

local function setHlVis(hl, v)
    if v then
        hl.FillTransparency = 0.8
        hl.OutlineTransparency = 0
    else
        hl.FillTransparency = 1
        hl.OutlineTransparency = 1
    end
end

local function applyTrapESP(color)
    local ingame = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Ingame")
    if not ingame then return end
    local function hasHook1(o)
        for _, c in ipairs(o:GetDescendants()) do
            if c:IsA("BasePart") and c.Name == "Hook1" then return true end
        end
        return false
    end
    local function ensure(t)
        if not t:FindFirstChild(TRAP_ESP) then
            local h = Instance.new("Highlight")
            h.Name = TRAP_ESP
            h.FillColor = color
            h.OutlineColor = Color3.fromRGB(255,255,255)
            h.OutlineTransparency = 0
            h.FillTransparency = 0.8
            h.Adornee = t
            h.Parent = t
            allHighlights[h] = true
        end
    end
    for _, o in ipairs(ingame:GetDescendants()) do
        if o:IsA("Model") or o:IsA("BasePart") then
            if o.Name == "Spike" or o.Name == "SubspaceTripmine" then
                ensure(o)
            elseif o.Name == "Shadow" then
                if o:IsA("BasePart") then o.Transparency = 0
                elseif o:IsA("Model") then
                    for _, p in ipairs(o:GetDescendants()) do
                        if p:IsA("BasePart") then p.Transparency = 0 end
                    end
                end
                ensure(o)
            elseif hasHook1(o) then
                ensure(o)
            elseif typeof(o.Name) == "string" and string.find(o.Name, "RespawnLocation") then
                if o:IsA("BasePart") then o.Transparency = 0
                elseif o:IsA("Model") then
                    for _, p in ipairs(o:GetDescendants()) do
                        if p:IsA("BasePart") then p.Transparency = 0 end
                    end
                end
                ensure(o)
            end
        end
    end
end

local function applyPlayerESP(char, color)
    if not char:IsA("Model") then return end
    if not Players:GetPlayerFromCharacter(char) then return end
    if char:FindFirstChild(PLAYER_ESP) then return end
    if char == LocalPlayer.Character then return end

    local h = Instance.new("Highlight")
    h.Name = PLAYER_ESP
    h.FillColor = color
    h.Adornee = char
    h.Parent = char

    local head = char:FindFirstChild("Head")
    if head then
        local bb = Instance.new("BillboardGui", head)
        bb.Name = "PlayerESPBillboard"
        bb.Size = UDim2.new(0,100,0,50)
        bb.StudsOffset = Vector3.new(0,2,0)
        local tl = Instance.new("TextLabel", bb)
        tl.Size = UDim2.new(1,0,1,0)
        tl.Text = "(" .. tostring(char.Name) .. ")"
        tl.TextColor3 = Color3.new(1,1,1)
        tl.TextStrokeTransparency = 0
        tl.TextStrokeColor3 = Color3.new(0,0,0)
        bb.AlwaysOnTop = true
        tl.BackgroundTransparency = 1
    end

    setHlVis(h, ESP_Enabled)
    allHighlights[h] = true
end

local function applyItemHl(tool, color)
    if not tool:FindFirstChild(ITEM_ESP) then
