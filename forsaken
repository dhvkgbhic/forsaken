    local function findGens()
        local mf = Workspace:FindFirstChild("Map")
        local ig = mf and mf:FindFirstChild("Ingame")
        local m = ig and ig:FindFirstChild("Map")
        local gens = {}
        if m then
            for _, g in ipairs(m:GetChildren()) do
                if g.Name == "Generator" and g:IsA("Model") and g:FindFirstChild("Progress") and g.Progress.Value < 100 then
                    local near = false
                    for _, p in ipairs(Players:GetPlayers()) do
                        local c = p.Character
                        local hr = c and c:FindFirstChild("HumanoidRootPart")
                        if hr and g:FindFirstChild("Main") and (hr.Position - g.Main.Position).Magnitude < 25 then
                            near = true
                            break
                        end
                    end
                    if not near then table.insert(gens, g) end
                end
            end
        end
        return gens
    end

    local c = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hr = c:WaitForChild("HumanoidRootPart")
    local last = hr.CFrame

    while true do
        local gens = findGens()
        if #gens == 0 then break end
        for _, g in ipairs(gens) do
            if g:FindFirstChild("Main") and g:FindFirstChild("Remotes")
                and g.Remotes:FindFirstChild("RE") and g.Remotes:FindFirstChild("RF") then
                local gp = g.Positions.Center.Position
                local gd
                if g.Instances.Generator:FindFirstChild("Cube") and g.Instances.Generator.Cube:IsA("BasePart") then
                    gd = (g.Instances.Generator.Cube.Position - gp).Unit
                else
                    gd = Vector3.new(0,0,1)
                end
                hr.CFrame = CFrame.new(gp + Vector3.new(0,0.5,0), gp + Vector3.new(gd.X, 0, gd.Z))
                task.wait(timebetweenpuzzles / 2)
                local p = g.Main:FindFirstChildOfClass("ProximityPrompt") or g.Main:FindFirstChild("Prompt")
                if p then fireproximityprompt(p, 1.5, false) end
                for _ = 1, 6 do
                    task.wait(2.5)
                    g.Remotes.RE:FireServer()
                end
                task.wait(timebetweenpuzzles / 5)
                g.Remotes.RF:InvokeServer("leave")
            end
        end
    end
    hr.CFrame = last
end

