--// ---------- Chance 自瞄 ----------
local aimbotConnection = nil
local function enableAimbot()
    local prev = nil
    local dt = 0.03
    aimbotConnection = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        local flintlock = char:FindFirstChild("Flintlock")
        if flintlock and flintlock.Transparency == 0 then
            local kf = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Killers")
            if kf then
                for _, km in pairs(kf:GetChildren()) do
                    if km:IsA("Model") and km:FindFirstChild("HumanoidRootPart") then
                        local hrp = km.HumanoidRootPart
                        local cur = hrp.Position
                        local vel = Vector3.new(0,0,0)
                        if prev then vel = (cur - prev)/dt end
                        prev = cur
                        local pred = cur + vel * timeAhead
                        local root = char:FindFirstChild("HumanoidRootPart")
                        if root then
                            hum.AutoRotate = false
                            root.CFrame = CFrame.new(root.Position, pred)
                        end
                    end
                end
            end
        else
            hum.AutoRotate = true
        end
    end)
end

local function disableAimbot()
    if aimbotConnection then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.AutoRotate = true end
        aimbotConnection:Disconnect()
        aimbotConnection = nil
    end
end

